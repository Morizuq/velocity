/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Entrypoint files: validate with server ETag (enables instant updates without hard refresh)
/index.html
  Cache-Control: public, no-cache, must-revalidate

/flutter_bootstrap.js
  Cache-Control: public, no-cache, must-revalidate

# Compiled JS bundle: cache locally and validate with ETag (0-byte transfer on 304 hit)
/main.dart.js
  Cache-Control: public, no-cache, must-revalidate

# Static assets & wasm binaries: cache immutably for peak load speed
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=86400

/*.svg
  Cache-Control: public, max-age=86400
